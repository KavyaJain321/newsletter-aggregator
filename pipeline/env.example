# Copy to the repo root as `.env` (git-ignored) and adjust. Environment variables override .env.
# Never commit real keys.

# --- LLM (runtime: local Ollama first, Groq fallback — never Anthropic) ---
OLLAMA_BASE_URL=http://localhost:11434      # e.g. Pranav's GPU box over Tailscale: http://<tailscale-ip>:11434
OLLAMA_MODEL=qwen3:14b                      # must be pulled on that host: `ollama pull qwen3:14b`
OLLAMA_EMBED_MODEL=nomic-embed-text
GROQ_API_KEY=                               # from console.groq.com — leave empty to disable Groq
GROQ_MODEL=qwen/qwen3-32b
LLM_PROVIDER_ORDER=ollama,groq
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=3
LLM_THINK=true                              # keep Qwen3 thinking ON for extraction (OFF produced empty cards)
LLM_LOG_TEXT=true                           # log prompts/outputs to data/llm_logs (git-ignored)

# --- Gmail (read-only; token is machine-local) ---
GMAIL_ACCOUNT=notifyy1008@gmail.com
GMAIL_TOKEN_PATH=tools/google-skill/.claude/google-skill.local.json
GMAIL_CLIENT_PATH=~/.config/google-skill/credentials.json

# --- Paths (relative paths resolve from the repo root) ---
PIPELINE_DATA_DIR=data
PIPELINE_OUT_DIR=out
FIXTURES_DIR=../newsletter-aggregator-fixtures

# --- On-demand remote Ollama (approved option A for the shared trijya-3 GPU box) ---
# When set, the pipeline starts a PRIVATE Ollama on the host over SSH only for a run, reaches it
# through its own SSH tunnel, and stops it after. OLLAMA_BASE_URL is then ignored for requests
# (the host's shared proxy port is never used, so other team services can't pick our instance up).
OLLAMA_REMOTE_SSH=                          # e.g. <wsl-user>@<tailscale-ip>  (key-based SSH only)
OLLAMA_REMOTE_BIN=$HOME/ollama/bin/ollama
OLLAMA_REMOTE_PORT=11436                    # private port on the host (NOT the shared 11434)
OLLAMA_TUNNEL_PORT=11437                    # local end of our SSH tunnel
OLLAMA_REMOTE_MAX_MINUTES=90                # hard cap; the server dies via `timeout` even if we crash
OLLAMA_MIN_FREE_VRAM_MB=10000               # refuse to start if the GPU is busier than this
OLLAMA_KEEP_ALIVE=2m                        # unload the model soon after the last request
REMOTE_TZ=Asia/Kolkata
REMOTE_BLACKOUT=03:50-06:50                 # host powers off 04:00 -> ~06:45 IST
REMOTE_BLACKOUT_DAYS=1-6                    # Mon-Sat (Sunday stays on)

# --- Shared-host health guard (heat / load; checked before start, every 30 s, and before each request) ---
HOST_START_GPU_TEMP_C=80                    # refuse to start at/above this
HOST_WARN_GPU_TEMP_C=82                     # pause our requests at/above this ...
HOST_RESUME_GPU_TEMP_C=78                   # ... until it cools to this
HOST_CRITICAL_GPU_TEMP_C=87                 # stop our Ollama immediately
HOST_MONITOR_INTERVAL_S=30
HOST_MAX_COOLDOWN_S=600                     # give up waiting (falls back to Groq if configured)
